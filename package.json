{
  "name": "nawat",
  "version": "0.0.0",
  "description": "نواة محرر نصوص كتلي عربي — Arabic Block Editor Core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "happy-dom": "^14.12.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "80 KB"
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<org>/nawat.git"
  },
  "dependencies": {
    "@bloklabs/core": "^2.1.0",
    "zustand": "^5.1.0"
  }
}
